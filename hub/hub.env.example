# Settings for scripts/hub-deploy.sh. Copy this file to local/hub.env (the local/ folder is never committed)
# and fill it in. Lines are KEY=VALUE; a value may start with ~/ for your home folder.

# Required: the hostname your Cloudflare tunnel answers on (no https://, no path).
NEOLESS_HUB_HOST=hub.example.com

# The tunnel's name, as in `cloudflared tunnel create <name>`. Default: neoless.
#NEOLESS_TUNNEL=neoless

# The three LaunchAgents are <prefix>-asr, <prefix>-hub and <prefix>-tunnel.
# Default: the prefix of the ones already installed, else app.neoless.
#NEOLESS_LABEL_PREFIX=app.neoless

# A Python that already has mlx, mlx-audio, aiohttp, numpy and scipy, to run the ASR worker with.
# Default: the script makes a venv in ~/Applications/neoless-hub/asr/.venv from hub/asr/requirements.txt.
#NEOLESS_ASR_PYTHON=~/somewhere/.venv/bin/python

# A command the release build runs under (a build lock, `nice`, …). Default: none.
#NEOLESS_BUILD_WRAPPER=nice

# Another pinned model for the ASR worker (bigger, slower, more memory; whether it hears you better was never
# measured: compare on your own voice). Download it first:
# <the worker's python> hub/asr/fetch_model.py --model mlx-community/Qwen3-ASR-1.7B-4bit
#NEOLESS_ASR_MODEL=mlx-community/Qwen3-ASR-1.7B-4bit

# A second, smaller model next to it. NEOLESS_ASR_MODEL is then the "large" model and this one the "small" one:
# a device can ask for either (识别模型 in the app's settings), and the small one stands in for ten minutes
# whenever the large one was too slow for this Mac (hub/asr/README.md). Default: none, one model.
#NEOLESS_ASR_FALLBACK_MODEL=mlx-community/Qwen3-ASR-0.6B-4bit

# Opt-in: the worker also saves every recording into this folder (0600; the newest 20, removed after 7 days),
# so you can compare models on your own voice. Leave it unset and no recording is kept anywhere.
#NEOLESS_ASR_KEEP_DIR=~/neoless-asr-recordings
